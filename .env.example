# Copie este arquivo para .env. Nunca envie BOT_TOKEN a ninguém.
BOT_TOKEN=COLE_AQUI_O_TOKEN_DO_BOT
CLIENT_ID=COLE_AQUI_O_APPLICATION_ID
GUILD_ID=COLE_AQUI_O_ID_DO_SERVIDOR

# Em Railway: anexe um Volume montado em /data e mantenha esta rota.
# No computador: use ./data/naples.sqlite
DATABASE_PATH=./data/naples.sqlite
